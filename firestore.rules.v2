rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validListing(data) {
      return data.keys().hasAll([
          'title', 'seller', 'size', 'alt', 'pay', 'ship', 'city', 'cat',
          'sold', 'cond', 'price', 'wa', 'photo', 'photos', 'owner', 'ts',
          'status'
        ])
        && data.keys().hasOnly([
          'title', 'seller', 'size', 'alt', 'pay', 'ship', 'city', 'cat',
          'sold', 'cond', 'price', 'wa', 'photo', 'photos', 'owner', 'ts',
          'status', 'featured'
        ])
        && data.title is string && data.title.size() <= 60
        && data.seller is string && data.seller.size() <= 40
        && data.size is string && data.size.size() <= 10
        && data.alt is string && data.alt.size() <= 150
        && data.pay is list && data.ship is list
        && data.city is string && data.city.size() <= 40
        && data.cat is string && data.cond is string
        && data.sold is bool
        && data.price is number && data.price >= 0
        && data.wa is string && data.wa.size() <= 20
        && (data.photo == null || data.photo is string)
        && data.photos is list && data.photos.size() <= 4
        && data.owner is string
        && data.ts is number
        && data.status in ['pending', 'approved']
        && (!data.keys().hasAny(['featured']) || data.featured is bool);
    }

    function validWanted(data) {
      return data.keys().hasAll(['text', 'name', 'city', 'wa', 'owner', 'ts'])
        && data.keys().hasOnly(['text', 'name', 'city', 'wa', 'owner', 'ts'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.city is string && data.city.size() <= 40
        && data.wa is string && data.wa.size() <= 20
        && data.owner is string
        && data.ts is number;
    }

    function validReview(data, reviewId) {
      return data.keys().hasAll(['seller', 'sellerName', 'rating', 'name', 'text', 'by', 'ts'])
        && data.keys().hasOnly(['seller', 'sellerName', 'rating', 'name', 'text', 'by', 'ts'])
        && data.by == request.auth.uid
        && data.seller is string
        && data.seller != request.auth.uid
        && reviewId == request.auth.uid + '_' + data.seller
        && data.sellerName is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.text is string && data.text.size() <= 200
        && data.ts is number;
    }

    match /listings/{listingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.owner == request.auth.uid)
        || resource.data.status == 'approved';
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'pending'
        && validListing(request.resource.data);
      allow update: if isAdmin()
        ? validListing(request.resource.data)
        : signedIn()
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && validListing(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasNone(['status', 'featured']);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    match /wanted/{wantedId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && validWanted(request.resource.data);
      allow update: if isAdmin() && validWanted(request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    match /mod/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sellers/{sellerUid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && validReview(request.resource.data, reviewId)
        && !exists(/databases/$(database)/documents/reviews/$(reviewId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.listing is string
        && request.resource.data.title is string
        && request.resource.data.ts is number;
      allow read, update, delete: if isAdmin();
    }
  }
}
